# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID du serveur et du salon (clic droit > Copier l'identifiant, mode développeur activé)
GUILD_ID=
CHANNEL_ID=

# Rôles à ping, séparés par des virgules (noms exacts sur le serveur)
ROLE_NAMES=Dev back,Dev front

# Lundi 9h, heure de Paris (format cron : minute heure jour mois jourSemaine)
CRON_SCHEDULE=0 9 * * 1
TIMEZONE=Europe/Paris

# Crée un fil "Récap semaine du ..." sous le message pour les réponses
CREATE_THREAD=true
